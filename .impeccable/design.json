      "html": "<section class=\"ds-summary\" aria-label=\"Сводка заказа\"><div class=\"ds-summary-row\"><span>Товары</span><b>—</b></div><div class=\"ds-summary-row\"><span>Скидка</span><b>—</b></div><hr class=\"ds-summary-line\"><div class=\"ds-summary-row ds-summary-total\"><span>Итого</span><b>—</b></div></section>",
      "css": ".ds-summary{font-family:var(--font-text,Montserrat,Arial,sans-serif);height:max-content;padding:18px 16px;border:0;border-radius:0;background:var(--surface,#f3f3f3);color:var(--foreground,#111);box-shadow:none}.ds-summary-row{display:flex;align-items:center;justify-content:space-between;min-height:28px;gap:12px;color:var(--muted,#595959);font-size:14px}.ds-summary-row b{font-weight:500}.ds-summary-line{height:1px;margin:4px 0 12px;border:0;background:var(--line,#d6d6d6)}.ds-summary-total{color:var(--foreground,#111)}"

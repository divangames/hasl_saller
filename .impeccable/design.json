      "html": "<button class=\"ds-primary\" type=\"button\">Добавить в корзину</button>",
      "css": ".ds-primary{font-family:var(--font-text,Montserrat,Arial,sans-serif);min-height:48px;padding:0 22px;border:0;border-radius:0;background:var(--brand,#ccff02);color:var(--foreground,#111);font-size:16px;font-weight:700;cursor:pointer;box-shadow:none;transition:transform 160ms var(--spring-press,cubic-bezier(.22,1,.36,1));}.ds-primary:active{transform:scale(.98)}.ds-primary:disabled{opacity:.65;cursor:not-allowed}@media(hover:hover) and (pointer:fine){.ds-primary:hover{background:var(--foreground,#111);color:var(--brand,#ccff02)}}.ds-primary:focus-visible{outline:3px solid var(--foreground,#111);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"

  "narrative": {
    "northStar": "Айдентика ХАСЛ",
    "overview": "Белая витрина с чёрной типографикой и лаймовыми действиями. Прямые углы и сочетание Montserrat с Unbounded воспроизводят заданную пользователем айдентику.\n\nДокумент фиксирует итоговый каскад: `styles.css`, затем `ui-refinement.css`, затем `hasl-theme.css`. Токены описывают повторяемые решения; исходная структура страниц и механика магазина остаются контрактом существующего приложения.",
    "keyCharacteristics": [
      "Прямые углы у контейнеров, контролов и псевдоэлементов.",
      "Лайм выделяет действие, выбор и достигнутую скидку.",
      "Montserrat обслуживает интерфейс; Unbounded — крупные заголовки.",
      "Промофото монохромные; товарные фотографии сохраняют исходные цвета."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Лайм обозначает действие или выбранное/достигнутое состояние; на лаймовой заливке используется чёрный текст.",
        "section": "colors"
      },
      {
        "name": "The Font Roles Rule",
        "body": "Крупные заголовки используют Unbounded, элементы управления и текст — Montserrat.",
        "section": "typography"
      },
      {
        "name": "The Square Rule",
        "body": "Все контейнеры, элементы управления и их псевдоэлементы имеют нулевой радиус во всех состояниях.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do использовать предоставленные логотип и favicon.",
      "Do сохранять чёрный текст на лаймовых действиях и выбранных состояниях.",
      "Do проверять квадратные углы и видимый клавиатурный фокус в обычном и активном состоянии.",
      "Do сохранять исходные цвета товарных фотографий и существующее поведение магазина."
    ],
    "donts": [
      "Don't возвращать скругления в контейнеры, контролы или псевдоэлементы.",
      "Don't заменять Montserrat и Unbounded другими шрифтами.",
      "Don't превращать унаследованные одноразовые эффекты в новые правила системы.",
      "Don't менять товарные данные, пороги скидок или размещение элементов в рамках ребрендинга."
    ]
  }

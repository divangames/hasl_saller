      "html": "<label class=\"ds-field\">Имя<input class=\"ds-input\" autocomplete=\"given-name\" placeholder=\"Ваше имя\"></label>",
      "css": ".ds-field{font-family:var(--font-text,Montserrat,Arial,sans-serif);display:grid;gap:8px;color:#333;font-size:14px}.ds-input{font-family:var(--font-text,Montserrat,Arial,sans-serif);height:56px;padding:0 16px;border:1px solid transparent;border-radius:0;background:var(--surface,#f3f3f3);color:var(--foreground,#111);font-size:16px;caret-color:var(--foreground,#111);box-shadow:none}.ds-input::placeholder{color:#696969}.ds-input:focus{border-color:var(--foreground,#111)}.ds-input:focus-visible{outline:3px solid var(--foreground,#111);outline-offset:3px;}"

      "html": "<nav class=\"ds-nav\" aria-label=\"Основная навигация\"><a class=\"ds-nav-item ds-nav-current\" href=\"#home\" aria-current=\"page\">Главная</a><a class=\"ds-nav-item\" href=\"#catalog\">Каталог</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:3px;background:var(--background,#fff)}.ds-nav-item{font-family:var(--font-text,Montserrat,Arial,sans-serif);display:inline-flex;align-items:center;gap:7px;min-height:44px;padding:6px 11px;border:0;border-radius:0;background:transparent;color:var(--foreground,#111);font-size:14px;font-weight:650;line-height:1;text-decoration:none;box-shadow:none;transition:color 160ms ease,background-color 160ms ease,transform 140ms var(--spring-press,cubic-bezier(.22,1,.36,1))}.ds-nav-current{background:var(--brand,#ccff02)}.ds-nav-item:active{transform:scale(.97)}@media(hover:hover) and (pointer:fine){.ds-nav-item:hover{background:#f7f7f7;color:#222}.ds-nav-current:hover{background:var(--brand,#ccff02);color:var(--foreground,#111)}}.ds-nav-item:focus-visible{outline:3px solid var(--foreground,#111);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
    },
    {
